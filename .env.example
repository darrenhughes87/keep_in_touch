# Copy to .env.local for development, or to .env on your server.
# Never commit a real .env.

# REQUIRED ------------------------------------------------------------

# The password you'll type to open the app. This is the only auth.
SESSION_PASSWORD=change-me

# Used to sign the session cookie. Must be at least 32 characters.
# Generate one: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Shared secret for internal cron routes (recomputes suggestions nightly).
CRON_SECRET=replace-with-another-random-string

# OPTIONAL ------------------------------------------------------------

# Enables Anthropic Claude Haiku for natural opener suggestions
# and morning briefing scripts. Without a key, the app uses
# templated local strings (still works, just less natural).
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Where data lives. Defaults to ./data in dev, /data in the container.
# DATA_DIR=./data

# Container image to run (production only — ignored in `pnpm dev`).
# Set this to your built image. Examples:
#   IMAGE=ghcr.io/<your-github-username>/keep_in_touch:latest
#   IMAGE=keep_in_touch:local   (if you built it on the host)
IMAGE=keep_in_touch:local

# Timezone for date math, e.g. Europe/London, America/New_York, Asia/Tokyo
TZ=UTC

# Web Push (optional). Generate with: pnpm vapid
# Required if you want to enable the morning notification toggle in Settings.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
